# --- Stack: maintained by the scripts ---
START_LOCAL_LAYOUT=2
# release tag or branch of the installed payload
START_LOCAL_REF=
# the same file works on Windows and Linux (§4)
COMPOSE_PATH_SEPARATOR=;
# empty: the installer asks for the DB provider and lists the defaults, docker-compose/https.yml included
COMPOSE_FILE=
# empty: the project (folder) name; migrated folders: virto
VOLUME_PREFIX=
# 0.0.0.0 allows access from other machines
BIND_ADDRESS=127.0.0.1

# --- Solution ---
# stable | stable:<N> | edge | custom; asked once when empty (B8)
RELEASE_CHANNEL=
# custom: path or URL of the package manifest
CUSTOM_PACKAGES_JSON=
# custom: storefront ZIP; empty = latest vc-frontend release
CUSTOM_FRONTEND_URL=
# ElasticSearch9 once that module is installed (D8)
SEARCH_PROVIDER=ElasticSearch8
# non-interactive runs apply it, generating one when empty (C1)
ADMIN_PASSWORD=

# --- Run from source (empty = Docker) ---
# vc-platform checkout or prebuilt platform folder
PLATFORM_SOURCE_PATH=
# ;-separated module *.Web folders, or one modules folder (H2)
MODULE_SOURCE_PATHS=
# true: start prepares a source platform but doesn't launch it (B6)
SKIP_PLATFORM=

# --- Versions, ports, limits ---
PGSQL_VERSION=18.3
PGSQL_PORT=5432
MYSQL_VERSION=9.3
MYSQL_PORT=3306
MSSQL_VERSION=2022-latest
MSSQL_PORT=1433
STACK_VERSION=9.5.5
ES_PORT=9200
KIBANA_PORT=5601
ES_MEM_LIMIT=1g
REDIS_PORT=6379
PLATFORM_PORT=8090
FRONTEND_PORT=443

# --- Secrets: filled at install when empty, never rotated ---
DB_PASSWORD=
REDIS_PASSWORD=
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
